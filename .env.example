# Copy this file to .env and fill in all values before running in production.
# Never commit .env to git.

# ── Django core ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=replace-with-a-60-char-random-string

# Set to False in production
DEBUG=False

# Comma-separated — no spaces around commas
ALLOWED_HOSTS=dcrs.simamia.online,www.dcrs.simamia.online

# ── Database (PostgreSQL for production) ──────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dcrs_db
DB_USER=dcrs_user
DB_PASSWORD=replace-with-strong-password
DB_HOST=localhost
DB_PORT=5432

# ── Email ─────────────────────────────────────────────────────────────────────
# Use console backend for dev; replace with SMTP/SendGrid for production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@dcrs.simamia.online

# ── Paths (optional — defaults work for most setups) ─────────────────────────
# STATIC_ROOT=/var/www/dcrs/app/staticfiles
# MEDIA_ROOT=/var/www/dcrs/app/media

# ── SMS (SendAfrica) ──────────────────────────────────────────────────────────
# Leave SENDAFRICA_API_KEY blank to use the internal SMS simulator (dev/demo).
# Get a key at https://sendafrica.online -> Settings -> API Keys
SENDAFRICA_BASE_URL=https://api.sendafrica.online
SENDAFRICA_API_KEY=
# Optional — sender ID shown on the recipient's phone (leave blank for default)
SENDAFRICA_SENDER_ID=

# In the SendAfrica dashboard, set SMS -> Settings -> Callback URLs -> Delivery Reports to:
# https://dcrs.simamia.online/portal/sms/callback/
